---
// Chinese province detail pages (served at "/zh/province/<slug>").
import ProvincePage from "../../../components/ProvincePage.astro";
import { provinces } from "../../../data/provinces";

export function getStaticPaths() {
  return provinces.map((province) => ({
    params: { slug: province.slug },
    props: { province },
  }));
}

const { province } = Astro.props;
---

<ProvincePage province={province} />
