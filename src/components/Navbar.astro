---
import Icon from "./Icon.astro";
import { useTranslate, localeUrls } from "../i18n/ui";

const t = useTranslate(Astro);
const langLinks = localeUrls(Astro);

const navLinks = [
  { href: "#story", key: "nav.story" },
  { href: "#how", key: "nav.how" },
  { href: "#device", key: "nav.device" },
  { href: "#knowledge", key: "nav.knowledge" },
  { href: "#contact", key: "nav.contact" },
];
---

<nav class="rg-nav">
  <a href="#top" class="rg-brand">
    <img src="/assets/img/logo.png" alt="RiceGuard Sentinel" class="rg-brand-logo" />
    <span class="rg-brand-text">
      <span class="rg-brand-th"><span data-i18n="brand.th">{t("brand.th")}</span></span>
      <span class="rg-brand-en">RiceGuard Sentinel</span>
    </span>
  </a>
  <div class="rg-navlinks" id="rg-navlinks">
    {
      navLinks.map((link) => (
        <a href={link.href} class="rg-navlink" data-i18n={link.key}>
          {t(link.key)}
        </a>
      ))
    }
  </div>
  <div class="rg-nav-right">
    <div class="rg-langswitch" role="group" aria-label="Language">
      {
        langLinks.map((l) => (
          <a
            href={l.href}
            hreflang={l.lang}
            lang={l.lang}
            class={`rg-lang-btn${l.active ? " is-active" : ""}`}
            aria-current={l.active ? "true" : undefined}
          >
            {l.label}
          </a>
        ))
      }
    </div>
    <button
      type="button"
      class="rg-burger"
      id="rg-burger"
      aria-label="เปิดเมนู"
      aria-expanded="false"
      aria-controls="rg-mobile-menu"
    >
      <Icon name="menu" size={22} class="rg-burger-open" />
      <Icon name="x" size={22} class="rg-burger-close" />
    </button>
  </div>
</nav>
