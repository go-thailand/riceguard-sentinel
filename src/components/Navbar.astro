---
import Icon from "./Icon.astro";

const navLinks = [
  { href: "#story", key: "nav.story", th: "เรื่องราว", en: "Story" },
  { href: "#how", key: "nav.how", th: "ทำงานอย่างไร", en: "How" },
  { href: "#device", key: "nav.device", th: "อุปกรณ์", en: "Device" },
  { href: "#knowledge", key: "nav.knowledge", th: "ฐานความรู้", en: "Knowledge" },
  { href: "#contact", key: "nav.contact", th: "ติดต่อ", en: "Contact" },
];
---

<nav class="rg-nav">
  <a href="#top" class="rg-brand">
    <img src="/assets/img/logo.png" alt="RiceGuard Sentinel" class="rg-brand-logo" />
    <span class="rg-brand-text">
      <span class="rg-brand-th"><span data-i18n="brand.th">ไรซ์การ์ด เซ็นทินัล</span></span>
      <span class="rg-brand-en">RiceGuard Sentinel</span>
    </span>
  </a>
  <div class="rg-navlinks" id="rg-navlinks">
    {
      navLinks.map((link) => (
        <a href={link.href} class="rg-navlink">
          <span data-i18n={link.key}>{link.th}</span>{" "}
          <span class="rg-navlink-en">/ {link.en}</span>
        </a>
      ))
    }
  </div>
  <div class="rg-nav-right">
    <div class="rg-langswitch" role="group" aria-label="Language">
      <button type="button" class="rg-lang-btn is-active" data-lang="th">ไทย</button>
      <button type="button" class="rg-lang-btn" data-lang="en">EN</button>
      <button type="button" class="rg-lang-btn" data-lang="zh">中文</button>
    </div>
    <button
      type="button"
      class="rg-burger"
      id="rg-burger"
      aria-label="เปิดเมนู"
      aria-expanded="false"
      aria-controls="rg-mobile-menu"
    >
      <Icon name="menu" size={22} class="rg-burger-open" />
      <Icon name="x" size={22} class="rg-burger-close" />
    </button>
  </div>
</nav>
