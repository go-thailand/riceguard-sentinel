---
import Icon from "../Icon.astro";
import Modal from "../Modal.astro";
import { t } from "../../i18n/ui";

const specs = [
  { icon: "ruler", value: "4 m", key: "device.spec0.th" },
  { icon: "sun", value: "2×200W", key: "device.spec1.th" },
  { icon: "battery-charging", value: "5–11 วัน", key: "device.spec2.th" },
  { icon: "gauge", value: "18", key: "device.spec3.th" },
  { icon: "shield", value: "IP68", key: "device.spec4.th" },
  { icon: "zap", value: "40 TOPS", key: "device.spec5.th" },
];

const features = [
  { icon: "wrench", titleKey: "device.feat0.title", descKey: "device.feat0.desc" },
  { icon: "wrench", titleKey: "device.feat1.title", descKey: "device.feat1.desc" },
  { icon: "zap", titleKey: "device.feat2.title", descKey: "device.feat2.desc" },
  { icon: "anchor", titleKey: "device.feat3.title", descKey: "device.feat3.desc" },
];

// Modal spec rows: label key + value (key `v`, or language-neutral `vRaw`).
const fullSpecs = [
  { l: "device.full.height.l", v: "device.full.height.v" },
  { l: "device.full.solar.l", v: "device.full.solar.v" },
  { l: "device.full.battery.l", v: "device.full.battery.v" },
  { l: "device.full.measure.l", v: "device.full.measure.v" },
  { l: "device.full.ip.l", vRaw: "IP68" },
  { l: "device.full.ai.l", vRaw: "40 TOPS (Edge)" },
  { l: "device.full.net.l", v: "device.full.net.v" },
  { l: "device.full.struct.l", v: "device.full.struct.v" },
];
---

<section id="device" class="rg-section rg-bg-dark">
  <div class="rg-container">
    <div class="rg-secnum" style="color:#C9A227;">
      <span class="rg-secnum-n">03</span>
      <span class="rg-secnum-line" style="background:#C9A227;"></span>
      <span class="rg-secnum-label">
        <span data-i18n="device.label">{t("device.label")}</span> · The Gen 4 Device
      </span>
    </div>
    <div class="rg-device-grid">
      <div class="rg-device-imgwrap" data-reveal>
        <img
          src="/assets/img/device-render.webp"
          alt="สถานี Gen 4 — เสาปริซึมหกเหลี่ยมบิด สูง 4 เมตร มงกุฎโซลาร์สองหน้า"
          loading="lazy"
          width="607"
          height="758"
        />
      </div>
      <div data-reveal data-reveal-delay="1">
        <h2 class="rg-h2 rg-h2-light">
          <span data-i18n="device.h2">{t("device.h2")}</span>
        </h2>
        <p class="rg-cap" style="color:#C9A227;" data-i18n="cap.device">{t("cap.device")}</p>
        <p class="rg-lead rg-lead-light">
          <span data-i18n="device.lead">{t("device.lead")}</span> — engineered to survive Thailand's
          monsoons.
        </p>
        <div class="rg-spec-grid">
          {
            specs.map((s) => (
              <div class="rg-spec-card">
                <Icon name={s.icon} size={20} class="rg-spec-icon" />
                <div class="rg-spec-value">{s.value}</div>
                <div class="rg-spec-th">
                  <span data-i18n={s.key}>{t(s.key)}</span>
                </div>
              </div>
            ))
          }
        </div>

        <div class="rg-device-extra">
          {
            features.map((f) => (
              <div class="rg-device-feature">
                <Icon name={f.icon} size={20} />
                <div>
                  <div class="rg-device-feature-title" data-i18n={f.titleKey}>{t(f.titleKey)}</div>
                  <p class="rg-device-feature-desc" data-i18n={f.descKey}>{t(f.descKey)}</p>
                </div>
              </div>
            ))
          }
        </div>

        <button type="button" class="rg-more-btn is-onlight" data-modal-open="modal-device">
          <Icon name="gauge" size={16} /> <span data-i18n="device.more">{t("device.more")}</span>
        </button>
      </div>
    </div>
  </div>

  <Modal id="modal-device" eyebrowKey="device.label" titleKey="device.modal.title">
    <table class="rg-spec-table">
      <tbody>
        {
          fullSpecs.map((row) => (
            <tr>
              <td data-i18n={row.l}>{t(row.l)}</td>
              {row.v ? <td data-i18n={row.v}>{t(row.v)}</td> : <td>{row.vRaw}</td>}
            </tr>
          ))
        }
      </tbody>
    </table>
  </Modal>
</section>

<style>
  .rg-spec-card :global(.rg-spec-icon) {
    color: #c9a227;
  }
</style>
