---
import Icon from "../Icon.astro";
import { t } from "../../i18n/ui";
---

<section id="contact" class="rg-section rg-bg-dark">
  <div class="rg-container">
    <div class="rg-secnum" style="color:#C9A227;">
      <span class="rg-secnum-n">11</span>
      <span class="rg-secnum-line" style="background:#C9A227;"></span>
      <span class="rg-secnum-label" style="color:#C9A227;">
        <span data-i18n="contact.label">{t("contact.label")}</span> · About &amp; Contact
      </span>
    </div>
    <div class="rg-contact-grid">
      <div data-reveal>
        <h2 class="rg-h2 rg-h2-light">
          <span data-i18n="contact.h2">{t("contact.h2")}</span>
        </h2>
        <p class="rg-cap" style="color:#C9A227;" data-i18n="cap.contact">{t("cap.contact")}</p>
        <p class="rg-contact-desc">
          <span data-i18n="contact.desc">{t("contact.desc")}</span>
        </p>
      </div>
      <div class="rg-contact-info" data-reveal data-reveal-delay="1">
        <div class="rg-contact-row">
          <Icon name="map-pin" size={18} class="rg-contact-svg" />
          <span>
            <span data-i18n="contact.address">{t("contact.address")}</span><br />
            <span class="rg-contact-sub"
              >348 Sukhumvit 101/1, Bangna Nuea, Bangna, Bangkok 10260</span
            >
          </span>
        </div>
        <div class="rg-contact-row">
          <Icon name="phone" size={18} class="rg-contact-svg" />
          <span>+66-6259-08888</span>
        </div>
        <div class="rg-contact-row">
          <Icon name="file-text" size={18} class="rg-contact-svg" />
          <span><span data-i18n="contact.tax">{t("contact.tax")}</span> · Tax ID 0105567015509 · สาขา 00000</span>
        </div>
        <div class="rg-contact-row">
          <Icon name="globe" size={18} class="rg-contact-svg" />
          <span>13°41'03"N 100°37'19"E</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .rg-contact-row :global(.rg-contact-svg) {
    color: #c9a227;
    flex: 0 0 auto;
    margin-top: 2px;
  }
</style>
