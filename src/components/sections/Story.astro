---
import SectionHeader from "../SectionHeader.astro";
import Icon from "../Icon.astro";
import Modal from "../Modal.astro";
import { useTranslate, getLang, getLocalizedImg } from "../../i18n/ui";

const t = useTranslate(Astro);
const lang = getLang(Astro);

// Gen 3 → Gen 4: evidence-driven redesign rows (i18n keys)
const beforeAfter = [
  { was: "story.baa.was0", now: "story.baa.now0" },
  { was: "story.baa.was1", now: "story.baa.now1" },
  { was: "story.baa.was2", now: "story.baa.now2" },
];

const timeline = [
  { when: "story.tl0.when", title: "story.tl0.title", desc: "story.tl0.desc", problem: false },
  { when: "story.tl1.when", title: "story.tl1.title", desc: "story.tl1.desc", problem: true },
  { when: "story.tl2.when", title: "story.tl2.title", desc: "story.tl2.desc", problem: false },
  { when: "story.tl3.when", title: "story.tl3.title", desc: "story.tl3.desc", problem: false },
];

const problems = ["story.prob0", "story.prob1", "story.prob2"];
const problemIcons = ["droplets", "battery-charging", "alert-triangle"];
---

<section id="story" class="rg-section rg-bg-white">
  <div class="rg-container">
    <SectionHeader
      num="01"
      labelKey="story.label"
      labelEn="The R&D Story"
      h2Key="story.h2"
      capKey="cap.story"
    />
    <p class="rg-lead" data-reveal>
      <span data-i18n="story.lead">{t("story.lead")}</span> — every Gen 4 decision traces to something
      the field taught us.
    </p>

    <div class="rg-story-grid">
      <!-- Gen 3 — the real problems the data revealed -->
      <div class="rg-story-card rg-story-card-light" data-reveal>
        <span class="tag tag-neutral" data-i18n="story.gen3.tag">{t("story.gen3.tag")}</span>
        <h3 class="rg-h3"><span data-i18n="story.gen3.h3">{t("story.gen3.h3")}</span></h3>
        <div class="rg-problem-panel">
          <div class="rg-problem-stat">
            <span class="rg-problem-stat-value">9.1%</span>
            <span class="rg-problem-stat-label" data-i18n="story.uptime.label" data-i18n-html="1"
              set:html={t("story.uptime.label")}
            />
          </div>
          <ul class="rg-problem-list">
            {
              problems.map((key, i) => (
                <li>
                  <Icon name={problemIcons[i]} size={16} /> <span data-i18n={key}>{t(key)}</span>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="washed rg-story-imgwrap">
          <img
            src={getLocalizedImg("/assets/img/story-gen3.webp", lang)}
            alt="Gen 3 ที่ติดตั้งจริง ที่ระโนด สงขลา"
            loading="lazy"
            width="766"
            height="431"
          />
        </div>
      </div>

      <!-- Gen 4 — before/after redesign summary -->
      <div class="rg-story-card rg-story-card-dark" data-reveal data-reveal-delay="1">
        <span class="rg-story-pill" data-i18n="story.gen4.pill">{t("story.gen4.pill")}</span>
        <h3 class="rg-h3 rg-h3-light"><span data-i18n="story.gen4.h3">{t("story.gen4.h3")}</span></h3>
        <table class="rg-baa-table">
          <thead>
            <tr>
              <th data-i18n="story.baa.problem">{t("story.baa.problem")}</th>
              <th></th>
              <th data-i18n="story.baa.fix">{t("story.baa.fix")}</th>
            </tr>
          </thead>
          <tbody>
            {
              beforeAfter.map((row) => (
                <tr>
                  <td class="rg-baa-was" data-i18n={row.was}>{t(row.was)}</td>
                  <td class="rg-baa-arrow">→</td>
                  <td class="rg-baa-now" data-i18n={row.now}>{t(row.now)}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
        <div class="washed rg-story-imgwrap">
          <img
            src={getLocalizedImg("/assets/img/07.webp", lang)}
            alt="สรุป Gen 4"
            loading="lazy"
            width="766"
            height="582"
          />
        </div>
      </div>
    </div>

    <!-- Problem → solution timeline + engineer certification -->
    <ol class="rg-timeline" data-reveal>
      {
        timeline.map((item) => (
          <li class={`rg-timeline-item${item.problem ? " rg-timeline-problem" : ""}`}>
            <div class="rg-timeline-when" data-i18n={item.when}>{t(item.when)}</div>
            <div class="rg-timeline-title" data-i18n={item.title}>{t(item.title)}</div>
            <p class="rg-timeline-desc" data-i18n={item.desc}>{t(item.desc)}</p>
          </li>
        ))
      }
    </ol>
    <span class="rg-badge-cert">
      <Icon name="shield-check" size={16} /> <span data-i18n="story.cert">{t("story.cert")}</span>
    </span>
    <br />
    <button type="button" class="rg-more-btn" data-modal-open="modal-story">
      <Icon name="file-text" size={16} /> <span data-i18n="story.more">{t("story.more")}</span>
    </button>
  </div>

  <Modal id="modal-story" eyebrowKey="story.modal.eyebrow" titleKey="story.modal.title">
    <p><span data-i18n="story.modal.p1">{t("story.modal.p1")}</span></p>
    <p><span data-i18n="story.modal.p2">{t("story.modal.p2")}</span></p>
    <p><span data-i18n="story.modal.p3">{t("story.modal.p3")}</span></p>
  </Modal>
</section>
