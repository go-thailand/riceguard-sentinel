---
import SectionHeader from "../SectionHeader.astro";
import Icon from "../Icon.astro";
import { t } from "../../i18n/ui";

// Representative live readouts (sample values from the Ranot trial plot)
const readouts = [
  { labelKey: "sensors.readout.ph", value: "5.8", unit: "", pct: 58 },
  { labelKey: "sensors.readout.ec", value: "1.2", unit: "dS/m", pct: 40 },
  { labelKey: "sensors.readout.moisture", value: "68", unit: "%", pct: 68 },
  { labelKey: "sensors.readout.npk", valueKey: "sensors.readout.npk.value", unit: "", pct: 72 },
  { labelKey: "sensors.readout.water", value: "4", unit: "cm", pct: 30 },
  { labelKey: "sensors.readout.temp", value: "31", unit: "°C", pct: 62 },
];

const stages = [
  "sensors.stage.seedling",
  "sensors.stage.tillering",
  "sensors.stage.booting",
  "sensors.stage.heading",
  "sensors.stage.ripening",
];
const activeStage = "sensors.stage.booting";
---

<section id="sensors" class="rg-section">
  <div class="rg-container">
    <SectionHeader
      num="04"
      labelKey="sensors.label"
      labelEn="Sensing &amp; Data Fusion"
      h2Key="sensors.h2"
      capKey="cap.sensors"
    />
    <p class="rg-lead" data-reveal>
      <span data-i18n="sensors.lead">{t("sensors.lead")}</span> — two streams of evidence, fused into
      one recommendation.
    </p>
    <div class="rg-fusion-grid">
      <!-- Soil / weather sensor readouts -->
      <div class="card rg-fusion-card" data-reveal>
        <div class="rg-fusion-card-head" style="color:#5A7326;">
          <Icon name="activity" size={20} />
          <span class="rg-fusion-card-title">
            <span data-i18n="sensors.data.title">{t("sensors.data.title")}</span> · Sensor data
          </span>
        </div>
        <div class="rg-readouts">
          {
            readouts.map((r) => (
              <div class="rg-readout">
                <div class="rg-readout-label" data-i18n={r.labelKey}>{t(r.labelKey)}</div>
                <div class="rg-readout-value">
                  {r.valueKey ? <span data-i18n={r.valueKey}>{t(r.valueKey)}</span> : r.value}{" "}
                  {r.unit && <small>{r.unit}</small>}
                </div>
                <div class="rg-readout-bar">
                  <span style={`width:${r.pct}%`} />
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <!-- Fusion node -->
      <div class="rg-fusion-node">
        <div class="rg-fusion-node-circle">
          <Icon name="git-merge" size={28} class="rg-fusion-svg" />
        </div>
        <span class="rg-fusion-node-label">
          <span data-i18n="sensors.fusion">{t("sensors.fusion")}</span><br />Fusion (AI)
        </span>
      </div>

      <!-- Crop / pest images with growth stage + bounding box -->
      <div class="card rg-fusion-card" data-reveal data-reveal-delay="1">
        <div class="rg-fusion-card-head" style="color:#A67C00;">
          <Icon name="camera" size={20} />
          <span class="rg-fusion-card-title">
            <span data-i18n="sensors.image.title">{t("sensors.image.title")}</span> · Crop &amp; pest
            images
          </span>
        </div>
        <div class="washed rg-fusion-imgwrap rg-bbox">
          <img
            src="/assets/img/sensors-image.webp"
            alt="เฟรมระยะการเจริญเติบโตของข้าว และการตรวจจับศัตรูพืช"
            loading="lazy"
            width="299"
            height="212"
          />
          <div class="rg-bbox-frame" style="top:34%;left:40%;width:30%;height:34%;">
            <span class="rg-bbox-tag" data-i18n="sensors.bbox">{t("sensors.bbox")}</span>
          </div>
        </div>
        <div class="rg-growth-stages">
          {
            stages.map((s) => (
              <span class={`rg-growth-chip${s === activeStage ? " is-active" : ""}`} data-i18n={s}>
                {t(s)}
              </span>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .rg-fusion-node-circle :global(.rg-fusion-svg) {
    color: #fff;
  }
</style>
