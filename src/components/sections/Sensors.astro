---
import SectionHeader from "../SectionHeader.astro";
import Icon from "../Icon.astro";

// Representative live readouts (sample values from the Ranot trial plot)
const readouts = [
  { label: "pH ดิน", value: "5.8", unit: "", pct: 58 },
  { label: "EC", value: "1.2", unit: "dS/m", pct: 40 },
  { label: "ความชื้นดิน", value: "68", unit: "%", pct: 68 },
  { label: "NPK", value: "สมดุล", unit: "", pct: 72 },
  { label: "ระดับน้ำ", value: "4", unit: "cm", pct: 30 },
  { label: "อุณหภูมิ", value: "31", unit: "°C", pct: 62 },
];

const stages = ["ระยะกล้า", "แตกกอ", "ตั้งท้อง", "ออกรวง", "สุกแก่"];
const activeStage = "ตั้งท้อง";
---

<section id="sensors" class="rg-section">
  <div class="rg-container">
    <SectionHeader
      num="04"
      labelKey="sensors.label"
      labelTh="เซ็นเซอร์และการหลอมรวมข้อมูล"
      labelEn="Sensing &amp; Data Fusion"
      h2Key="sensors.h2"
      h2Th="ตัวเลขจากดิน · ภาพจากต้นข้าว"
      cap="Numbers from the soil, images from the crop"
    />
    <p class="rg-lead" data-reveal>
      <span data-i18n="sensors.lead"
        >18 การวัด หลอมรวมกับภาพการเจริญเติบโตและศัตรูพืช เพื่อให้คำแนะนำที่แม่นยำ</span
      > — two streams of evidence, fused into one recommendation.
    </p>
    <div class="rg-fusion-grid">
      <!-- Soil / weather sensor readouts -->
      <div class="card rg-fusion-card" data-reveal>
        <div class="rg-fusion-card-head" style="color:#5A7326;">
          <Icon name="activity" size={20} />
          <span class="rg-fusion-card-title">
            <span data-i18n="sensors.data.title">ข้อมูลเซ็นเซอร์</span> · Sensor data
          </span>
        </div>
        <div class="rg-readouts">
          {
            readouts.map((r) => (
              <div class="rg-readout">
                <div class="rg-readout-label">{r.label}</div>
                <div class="rg-readout-value">
                  {r.value} {r.unit && <small>{r.unit}</small>}
                </div>
                <div class="rg-readout-bar">
                  <span style={`width:${r.pct}%`} />
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <!-- Fusion node -->
      <div class="rg-fusion-node">
        <div class="rg-fusion-node-circle">
          <Icon name="git-merge" size={28} class="rg-fusion-svg" />
        </div>
        <span class="rg-fusion-node-label">
          <span data-i18n="sensors.fusion">หลอมรวม</span><br />Fusion (AI)
        </span>
      </div>

      <!-- Crop / pest images with growth stage + bounding box -->
      <div class="card rg-fusion-card" data-reveal data-reveal-delay="1">
        <div class="rg-fusion-card-head" style="color:#A67C00;">
          <Icon name="camera" size={20} />
          <span class="rg-fusion-card-title">
            <span data-i18n="sensors.image.title">ภาพต้นข้าวและศัตรูพืช</span> · Crop &amp; pest
            images
          </span>
        </div>
        <div class="washed rg-fusion-imgwrap rg-bbox">
          <img
            src="/assets/img/sensors-image.webp"
            alt="เฟรมระยะการเจริญเติบโตของข้าว และการตรวจจับศัตรูพืช"
            loading="lazy"
            width="299"
            height="212"
          />
          <div class="rg-bbox-frame" style="top:34%;left:40%;width:30%;height:34%;">
            <span class="rg-bbox-tag">หนอนกอ · 92%</span>
          </div>
        </div>
        <div class="rg-growth-stages">
          {
            stages.map((s) => (
              <span class={`rg-growth-chip${s === activeStage ? " is-active" : ""}`}>{s}</span>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .rg-fusion-node-circle :global(.rg-fusion-svg) {
    color: #fff;
  }
</style>
