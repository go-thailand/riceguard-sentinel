---
import Icon from "./Icon.astro";
import { t } from "../i18n/ui";

// Reusable modal. Open it from anywhere with a trigger that carries
// data-modal-open="<id>"; wiring lives in src/scripts/ui.js.
// Works identically on desktop and mobile (scrollable, height-capped panel,
// body-scroll lock, backdrop-click + Escape to close).
// Pass titleKey/eyebrowKey (i18n keys) so the heading switches language, or the
// plain title/eyebrow strings for static text.
interface Props {
  id: string;
  title?: string;
  eyebrow?: string;
  titleKey?: string;
  eyebrowKey?: string;
}
const { id, title, eyebrow, titleKey, eyebrowKey } = Astro.props;
---

<div class="rg-modal" id={id} role="dialog" aria-modal="true" aria-hidden="true" aria-labelledby={`${id}-title`}>
  <div class="rg-modal-panel">
    <div class="rg-modal-head">
      <div>
        {
          eyebrowKey ? (
            <div class="rg-modal-eyebrow" data-i18n={eyebrowKey}>{t(eyebrowKey)}</div>
          ) : (
            eyebrow && <div class="rg-modal-eyebrow">{eyebrow}</div>
          )
        }
        {
          titleKey ? (
            <h3 class="rg-modal-title" id={`${id}-title`} data-i18n={titleKey}>{t(titleKey)}</h3>
          ) : (
            <h3 class="rg-modal-title" id={`${id}-title`}>{title}</h3>
          )
        }
      </div>
      <button type="button" class="rg-modal-close" data-modal-close aria-label="ปิด">
        <Icon name="x" size={18} />
      </button>
    </div>
    <div class="rg-modal-body">
      <slot />
    </div>
  </div>
</div>
