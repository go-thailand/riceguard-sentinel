---
import { useTranslate, localeUrls } from "../i18n/ui";

const t = useTranslate(Astro);
const langLinks = localeUrls(Astro);

const navLinks = [
  { href: "#story", key: "nav.story" },
  { href: "#how", key: "nav.how" },
  { href: "#device", key: "nav.device" },
  { href: "#knowledge", key: "nav.knowledge" },
  { href: "#contact", key: "nav.contact" },
];
---

<div class="rg-mobile-menu" id="rg-mobile-menu">
  {
    navLinks.map((link) => (
      <a href={link.href} class="rg-navlink rg-mobile-link" data-i18n={link.key}>
        {t(link.key)}
      </a>
    ))
  }
  <div class="rg-langswitch rg-langswitch-mobile" role="group" aria-label="Language">
    {
      langLinks.map((l) => (
        <a
          href={l.href}
          hreflang={l.lang}
          lang={l.lang}
          class={`rg-lang-btn${l.active ? " is-active" : ""}`}
          aria-current={l.active ? "true" : undefined}
        >
          {l.label}
        </a>
      ))
    }
  </div>
</div>
<div class="rg-mobile-backdrop" id="rg-mobile-backdrop"></div>
