---
// Global image lightbox — zero dependencies.
//
// Any <img data-lightbox> anywhere on the page becomes clickable and opens this
// full-screen <dialog>, showing the image enlarged and centred. Wiring is done
// once via event delegation, so new images just need the attribute (no per-image
// JS). Add the `rg-zoomable` class too for the cursor + hover affordance.
//
// Include ONCE in Layout.astro (already done) so it's available on every page.
// Closes on: the X button, a click on the dark backdrop, or Escape (native).
---

<dialog id="rg-lightbox" class="rg-lightbox" aria-label="ดูรูปภาพขนาดใหญ่">
  <button type="button" class="rg-lightbox-close" data-lightbox-close aria-label="ปิด">&times;</button>
  <img class="rg-lightbox-img" alt="" />
</dialog>

<style is:global>
  /* Opt-in affordance for any clickable/zoomable image. */
  .rg-zoomable {
    cursor: zoom-in;
    transition: opacity 0.2s ease;
  }
  .rg-zoomable:hover {
    opacity: 0.9;
  }

  /* The lightbox dialog fills the viewport; the image is centred inside it.
     Only apply display:flex when [open] so the native hidden state still works. */
  .rg-lightbox {
    border: none;
    padding: 0;
    margin: 0;
    width: 100vw;
    height: 100vh;
    max-width: 100vw;
    max-height: 100vh;
    background: transparent;
    overflow: hidden;
  }
  .rg-lightbox[open] {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .rg-lightbox::backdrop {
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(2px);
  }

  .rg-lightbox-img {
    max-width: 92vw;
    max-height: 88vh;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 8px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
    /* Clicks on the image itself must NOT bubble up as a backdrop close. */
    cursor: default;
  }

  .rg-lightbox-close {
    position: fixed;
    top: 16px;
    right: 20px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: none;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.92);
    color: #1a1a1a;
    font-size: 26px;
    line-height: 1;
    cursor: pointer;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.25);
  }
  .rg-lightbox-close:hover {
    background: #fff;
  }
</style>

<script>
  (function lightbox() {
    const dlg = document.getElementById("rg-lightbox");
    if (!dlg || typeof dlg.showModal !== "function") return; // no <dialog> support → images stay as-is
    const img = dlg.querySelector(".rg-lightbox-img");

    // Delegate: any click on an [data-lightbox] image opens the lightbox.
    // Delegation means images added by any component/page work automatically.
    document.addEventListener("click", (e) => {
      const trigger = e.target.closest("img[data-lightbox]");
      if (!trigger) return;
      // currentSrc respects srcset/responsive picks; falls back to src.
      img.src = trigger.currentSrc || trigger.src;
      img.alt = trigger.alt || "";
      dlg.showModal();
      document.body.style.overflow = "hidden"; // lock scroll behind the overlay
    });

    function close() {
      if (dlg.open) dlg.close();
    }

    dlg.querySelector("[data-lightbox-close]").addEventListener("click", close);

    // Backdrop click: the click lands on the <dialog> box itself (not the image
    // or the X button), so target === dlg means "clicked the dark area".
    dlg.addEventListener("click", (e) => {
      if (e.target === dlg) close();
    });

    // 'close' fires for the button, backdrop, and native Escape — clean up here.
    dlg.addEventListener("close", () => {
      document.body.style.overflow = "";
      img.removeAttribute("src");
    });
  })();
</script>
