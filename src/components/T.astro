---
import { t, getLang } from "../i18n/ui";

// Renders a translatable string from the i18n dictionary in the page's
// language (resolved from the URL via Astro.currentLocale). Server-rendered,
// so each /en/ · /zh/ · / URL ships fully-translated HTML (SEO + no flash).
// Use `html` for entries that contain markup (e.g. hero.title with <br>).
interface Props {
  key: string;
  html?: boolean;
  class?: string;
}
const { key, html = false, class: className } = Astro.props;
const value = t(key, getLang(Astro));
---

{
  html ? (
    <span class={className} set:html={value} />
  ) : (
    <span class={className}>{value}</span>
  )
}
