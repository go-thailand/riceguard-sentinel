---
import { useTranslate } from "../i18n/ui";

const t = useTranslate(Astro);

// Legend overlay for the province map — positioned bottom-left by CSS.
// Reused by the home map, the Map Modal, and the /research-map page.
---

<div class="rg-map-legend">
  <div class="rg-map-legend-title" data-i18n="map.legend.title">{t("map.legend.title")}</div>
  <div class="rg-map-legend-items">
    <span><i style="background:#5A7326"></i><span data-i18n="region.north">{t("region.north")}</span></span>
    <span><i style="background:#8FB43A"></i><span data-i18n="region.northeast">{t("region.northeast")}</span></span>
    <span><i style="background:#C9A227"></i><span data-i18n="region.central">{t("region.central")}</span></span>
    <span><i style="background:#C67139"></i><span data-i18n="region.south">{t("region.south")}</span></span>
  </div>
</div>
